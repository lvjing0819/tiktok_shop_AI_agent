# demo is offline; set bailian for real calls. Do not commit your .env.
MODEL_MODE=demo
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
# Use DATABASE_URL for PostgreSQL. Otherwise local SQLite is used.
# DATABASE_URL=postgresql://shop:shop_local@127.0.0.1:5432/shop
DATABASE_PATH=shop.sqlite
CHECKPOINT_PATH=shop.checkpoints.sqlite
# Optional local single-owner access token, not a multi-user login system.
APP_TOKEN=
# Run python -m scripts.setup_ads to generate this key locally (never commit it).
ADS_TOKEN_ENCRYPTION_KEY=
ADS_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/ads/oauth/callback
# Optional exact read-tool names, after reviewing official schemas. Writes remain blocked.
ADS_READ_TOOL_ALLOWLIST=
# TikTok Social uses its own OAuth records and TikTok-account authorization.
SOCIAL_AUTH_MODE=oauth
SOCIAL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/social/oauth/callback
# Optional separate encryption key. Empty means reuse the local master encryption key.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# api_token mode only: Organic API TikTok USER token, not an Ads token.
SOCIAL_API_ACCESS_TOKEN=

# TikTok Shop seller authorization: real values only in the ignored local .env.
SHOP_APP_KEY=
SHOP_APP_SECRET=
SHOP_SERVICE_ID=
# Optional official copied authorization URL; service_id can be read from it.
SHOP_AUTHORIZATION_URL=
# ROW or US. A copied official authorization URL determines its own region.
SHOP_AUTH_REGION=ROW
SHOP_OAUTH_REDIRECT_URI=https://your-domain.example/api/tiktokshop/callback
# Optional separate key; empty reuses ADS_TOKEN_ENCRYPTION_KEY.
SHOP_TOKEN_ENCRYPTION_KEY=
# Optional existing Shop grant from the SAME app; import through /api/shop/import-token.
# These are not Ads or Social MCP tokens. Empty values do not imply authorization.
SHOP_ACCESS_TOKEN=
SHOP_REFRESH_TOKEN=

# Local order/settlement ledger refresh. 0 disables periodic reads.
# Viewing the dashboard registers its authorized shops; no model call is involved.
ANALYTICS_SYNC_INTERVAL_SECONDS=900
ANALYTICS_SYNC_LOOKBACK_DAYS=7

# Agent runtime retention: keep disabled until migration and preview are reviewed.
AGENT_CLEANUP_ENABLED=0
AGENT_TRACE_RETENTION_DAYS=14
AGENT_RESULT_RETENTION_DAYS=30
AGENT_REPORT_RETENTION_DAYS=30
AGENT_SUMMARY_RETENTION_DAYS=180
AGENT_CLEANUP_GRACE_DAYS=7
AGENT_READ_RESULT_TTL_SECONDS=900
MEMORY_RECENT_MAX_CHARS=12000

# Small file outputs: empty key reuses the existing Ads encryption master key.
SANDBOX_ARTIFACT_KEY=
SANDBOX_ARTIFACT_DIR=.sandbox-files
