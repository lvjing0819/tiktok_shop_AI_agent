# demo is offline; set bailian for real calls. Do not commit your .env.
MODEL_MODE=demo
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
# Use DATABASE_URL for PostgreSQL. Otherwise local SQLite is used.
# DATABASE_URL=postgresql://shop:shop_local@127.0.0.1:5432/shop
DATABASE_PATH=shop.sqlite
CHECKPOINT_PATH=shop.checkpoints.sqlite
# Optional local single-owner access token, not a multi-user login system.
APP_TOKEN=
# Run python -m scripts.setup_ads to generate this key locally (never commit it).
ADS_TOKEN_ENCRYPTION_KEY=
ADS_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/ads/oauth/callback
# Optional exact read-tool names, after reviewing official schemas. Writes remain blocked.
ADS_READ_TOOL_ALLOWLIST=
